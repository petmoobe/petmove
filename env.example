# Render (despliegue)
# Copia este archivo como .env antes de subir nada a un repositorio público.
# .env nunca se sube a GitHub: está en .gitignore.

# Cadena de conexión a PostgreSQL.
# En Render: New → PostgreSQL, y copia la Internal Database URL.
# Fuera de Render (Railway, Supabase, Neon) usa la URL que te den.
DATABASE_URL=postgresql://usuario:contrasena@host:5432/base_de_datos

# Token del panel de administración. Ponlo largo y no lo compartas.
# Si no lo defines, se genera uno aleatorio en cada arranque y el panel
# dejaría de funcionar tras cada reinicio.
ADMIN_TOKEN=cambia-esto-por-un-token-largo-y-unico

# Entorno
NODE_ENV=production

# Opcional: puerto (Render lo asigna solo)
# PORT=3000

# Opcional: en local, ruta del archivo SQLite
# DB_PATH=./petmove.db
